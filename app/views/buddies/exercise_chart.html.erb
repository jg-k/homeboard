<%= render PageLayout.new(title: @exercise_type.name, subtitle: "#{@user.display_name} &bull; #{@exercise_type.category.titleize} &bull; #{@exercise_type.unit}".html_safe) do %>
  <div class="mb-6">
    <%= link_to "&larr; Back to #{@user.display_name}'s Activity".html_safe, activity_buddy_path(@user) %>
  </div>

  <%= progress_controls(@progress.choice) { |choice| exercise_chart_buddy_path(@user, @exercise_type, **choice) } %>

  <div class="card">
    <% if @progress.any? %>
      <%= progress_chart(@progress, unit: @exercise_type.unit) %>
    <% else %>
      <p class="text-muted text-center py-8">No data yet.</p>
    <% end %>
  </div>
<% end %>
