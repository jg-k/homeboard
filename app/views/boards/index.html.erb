<%= render PageLayout.new(title: "My Boards") do %>
  <% if @boards.any? %>
    <div class="stack-md">
      <% @boards.each do |board| %>
        <div class="card">
          <div class="flex-between mb-2">
            <h2 class="text-2xl font-semibold">
              <%= link_to board.name, board, class: "link-plain" %>
            </h2>
            <div class="flex gap-2">
              <%= link_to edit_board_path(board), class: "btn-icon", title: "Edit board" do %>
                <%= icon(:edit) %>
              <% end %>
              <%= link_to export_board_path(board, format: :pdf), class: "btn-icon", title: "Export PDF", data: { turbo: false } do %>
                <%= icon(:download) %>
              <% end %>
            </div>
          </div>

          <% if board.description.present? %>
            <p class="text-muted mb-2"><%= board.description %></p>
          <% end %>
          <% if board.grading_system %>
            <p class="text-sm text-muted mb-3">Grading system: <%= board.grading_system.name %></p>
          <% end %>

          <% layouts = board.visible_layouts %>
          <% if layouts.any? %>
            <ul class="layout-chips">
              <% layouts.each do |layout| %>
                <li class="layout-chip">
                  <%= layout.name %>
                  <% if layout.active? %>
                    <%= render Badge.new(:blue) { "Active" } %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted italic mb-4">No layouts yet</p>
          <% end %>

          <div class="flex gap-2 flex-wrap items-center">
            <%= link_to "View #{pluralize(@problem_counts.fetch(board.id, 0), 'problem')}",
                  board_problems_path(board), class: "btn btn-primary btn-sm" %>
            <%= link_to "Manage layouts", board, class: "btn btn-outline btn-sm" %>
            <%# Caching a board for offline use belongs where you pick a board,
                not inside the one you already opened. %>
            <span class="offline-control"
                  data-controller="board-offline"
                  data-board-offline-board-id-value="<%= board.id %>"
                  data-board-offline-manifest-path-value="<%= offline_manifest_board_path(board, format: :json) %>">
              <button type="button"
                      data-board-offline-target="button"
                      data-action="board-offline#toggle"
                      class="btn btn-outline btn-sm">Make available offline</button>
              <span class="text-xs text-muted" data-board-offline-target="status"></span>
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <%= link_to "New board", new_board_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No boards found</h3>
      <p>Create a board to start adding climbing problems.</p>
      <div class="empty-state-actions">
        <%= link_to "New board", new_board_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
<% end %>
