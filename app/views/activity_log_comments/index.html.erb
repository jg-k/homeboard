<%= render PageLayout.new(title: @category ? "#{@category.titleize} Comments" : "Activity Comments") do %>

  <%= render TabBar.new(label: "Comment category", tabs: [
        TabBar::Tab.new(label: "All", url: activity_comments_path(type: @activity_type), active: @category.nil?),
        *ActivityLogComment::CATEGORIES.map { |cat|
          TabBar::Tab.new(label: "#{cat.titleize} (#{@counts[cat] || 0})",
                          url: activity_comments_path(category: cat, type: @activity_type), active: @category == cat)
        }
      ]) %>

  <%= form_with url: activity_comments_path, method: :get, local: true,
      class: "form-inline mb-4",
      data: { controller: "auto-submit" } do %>
    <% if @category %><%= hidden_field_tag :category, @category %><% end %>
    <div class="form-group">
      <%= label_tag :type, "Activity type", class: "form-label" %>
      <%= select_tag :type,
          options_for_select(
            [ [ "All activities", "" ] ] + ActivityLogCommentsController::ACTIVITY_TYPES.map { |t| [ t.titleize, t ] },
            @activity_type
          ),
          class: "form-select",
          data: { action: "change->auto-submit#submit" } %>
    </div>
  <% end %>

  <% if @comments.any? %>
    <div class="activity-list">
      <% @comments.group_by { |c| c.created_at.to_date }.each do |date, comments| %>
        <div class="activity-date-group">
          <div class="date-divider">
            <span class="date-divider-text"><%= date.strftime("%A, %B %d, %Y") %></span>
          </div>
          <div class="stack">
            <% comments.each do |comment| %>
              <%= render "comment_row", comment: comment %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render EmptyState.new(title: "No #{@category&.titleize} comments yet".squish,
                              description: "Add comments from any activity log entry to track #{@category || "your"} observations.") do %>
      <%= link_to "Go to Activity Log", activity_path, class: "btn btn-primary" %>
    <% end %>
  <% end %>
<% end %>
