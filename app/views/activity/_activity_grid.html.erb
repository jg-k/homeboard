<%
  end_date = local_assigns.fetch(:grid_end_date, Date.current)
  label_start_date = local_assigns.fetch(:grid_start_date, (end_date - 52.weeks))
  start_date = label_start_date.beginning_of_week(:sunday)
  show_legend = local_assigns.fetch(:show_legend, true)
  legend_filter = local_assigns.fetch(:legend_filter, false)
  active_category = local_assigns[:active_category]

  weeks = []
  current_date = start_date
  while current_date <= end_date
    week = []
    7.times do
      week << current_date if current_date <= end_date
      current_date += 1.day
    end
    weeks << week
  end
%>

<div class="card activity-grid mb-6">
  <% if show_legend %>
    <div class="grid-legend">
      <% if legend_filter %>
        <%= link_to "All", activity_path,
                    class: "legend-item legend-filter#{' legend-filter-active' if active_category.nil?}" %>
      <% end %>
      <% ActivityCalendar::DayActivity::LEGEND_LABELS.each do |category, label| %>
        <% dot_class = "legend-dot grid-day-#{category.to_s.tr('_', '-')} intensity-5" %>
        <% if legend_filter %>
          <%= link_to activity_path(category: category),
                      class: "legend-item legend-filter#{' legend-filter-active' if active_category == category}" do %>
            <span class="<%= dot_class %>"></span>
            <span><%= label %></span>
          <% end %>
        <% else %>
          <div class="legend-item">
            <span class="<%= dot_class %>"></span>
            <span><%= label %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="grid-container">
    <div class="grid-weeks">
      <% weeks.each do |week| %>
        <div class="grid-week">
          <% week.each do |date| %>
            <% day = activity_data[date] || ActivityCalendar::DayActivity.new %>
            <% if day.any? %>
              <% day_url = local_assigns[:grid_day_url] ? grid_day_url.call(date) : activity_day_path(date: date.iso8601) %>
              <%= link_to day_url,
                          class: day.css_class,
                          title: day.tooltip(date),
                          data: local_assigns[:grid_link_data] || { turbo_frame: "activity_day_detail" } do %><% end %>
            <% else %>
              <div class="<%= day.css_class %>" title="<%= day.tooltip(date) %>"></div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid-dates">
    <span><%= label_start_date.strftime('%b %Y') %></span>
    <span><%= end_date.strftime('%b %Y') %></span>
  </div>
</div>
