<%#
  Prev/next always render as anchors, even when there is nowhere to go: the
  offline-filter controller rewrites these in place when a cached page is
  filtered client-side, and it needs an element to hand an href to. An
  anchor without an href is inert, same as the span it replaces.
%>
<div class="problem-nav mb-4">
  <%= tag.a href: (prev_problem ? board_problem_path(@current_board, prev_problem, filter_params) : nil),
            class: "problem-nav-btn #{'problem-nav-disabled' unless prev_problem}",
            data: { turbo_frame: dom_id(@current_board, :problem_detail_mobile),
                    offline_filter_target: "navPrev" } do %>
    <%= icon(:chevron_left) %>
  <% end %>
  <span class="problem-nav-position" data-offline-filter-target="navPosition">
    <%= problem_position %> / <%= problem_count %>
  </span>
  <%= tag.a href: (next_problem ? board_problem_path(@current_board, next_problem, filter_params) : nil),
            class: "problem-nav-btn #{'problem-nav-disabled' unless next_problem}",
            data: { turbo_frame: dom_id(@current_board, :problem_detail_mobile),
                    offline_filter_target: "navNext" } do %>
    <%= icon(:chevron_right) %>
  <% end %>
</div>
