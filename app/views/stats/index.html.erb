<%= render PageLayout.new(title: "Stats") do %>
  <div class="tabs">
    <%= link_to "Overview", stats_path(tab: "overview"),
        class: "tab-link #{@tab == 'overview' ? 'tab-active' : ''}" %>
    <%= link_to "Fitness", stats_path(tab: "fitness"),
        class: "tab-link #{@tab == 'fitness' ? 'tab-active' : ''}" %>
  </div>
  <div class="text-right mb-6">
    <%= link_to "View activity comments &rarr;".html_safe, activity_comments_path,
        class: "text-sm text-muted" %>
  </div>
  <% if @tab == "overview" %>
    <div class="mb-4">
      <%= render SegmentedControl.new(label: "Look-back period", options: Charts::Period.all.map { |period|
            SegmentedControl::Option.new(label: period.label, url: stats_path(tab: "overview", period: period), active: period == @period)
          }) %>
    </div>
    <div class="card mb-6">
      <h2 class="text-xl font-semibold mb-4">Climbing attempts and sends per <%= @period.bucket %></h2>
      <%= column_chart @climbing_chart_data,
                       stacked: true,
                       height: "240px",
                       colors: chart_palette,
                       dataset: modern_bar_dataset,
                       library: modern_column_chart_options(stacked: true) %>
    </div>
    <% if @exercise_chart_data.any? %>
      <div class="card">
        <h2 class="text-xl font-semibold mb-4">Conditioning training per <%= @period.bucket %></h2>
        <%= column_chart @exercise_chart_data,
                         stacked: true,
                         height: "240px",
                         colors: chart_palette,
                         library: modern_column_chart_options(stacked: true) %>
      </div>
    <% end %>
  <% elsif @tab == "fitness" %>
    <% if @categories.any? %>
      <div class="tabs-nav mb-6">
        <% @categories.each do |category| %>
          <%= link_to category.titleize, stats_path(tab: "fitness", category: category),
              class: "tab-link #{@category == category ? 'tab-active' : ''}" %>
        <% end %>
      </div>
      <% if @exercise_types.any? %>
        <%= progress_controls(@progress_choice) { |choice|
              stats_path(tab: "fitness", category: @category, **choice)
            } %>
        <div class="stack-lg">
          <% @exercise_types.each do |exercise_type| %>
            <div class="card">
              <h2 class="text-xl font-semibold mb-4">
                <%= exercise_type.name %>
                <span class="text-sm font-normal text-muted">(<%= exercise_type.unit %>)</span>
              </h2>
              <% progress = @progress_by_type.fetch(exercise_type) %>
              <% if progress.any? %>
                <%= progress_chart(progress, unit: exercise_type.unit, height: "240px") %>
              <% else %>
                <p class="text-muted text-center py-8">No data yet. <%= link_to "Log an activity", new_exercise_path %>.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <h3>No exercises in this category</h3>
          <p>Create exercise types to start tracking stats.</p>
          <div class="empty-state-actions">
            <%= link_to "Create Exercise Type", new_exercise_type_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <h3>No exercise types defined</h3>
        <p>Create exercise types to start tracking stats.</p>
        <div class="empty-state-actions">
          <%= link_to "Create Exercise Type", new_exercise_type_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
