<%= render PageLayout.new(title: @board.name, subtitle: @board.description.presence) do %>
  <div class="mb-8">
    <h2 class="text-2xl font-semibold mb-4">Layouts</h2>
    <% @layouts.each do |layout| %>
      <% problems = @problems_by_layout.fetch(layout.id, []) %>
      <div class="card mb-4 <%= 'card-active' if layout.active? %>">
        <div class="flex justify-between items-start gap-2 mb-4">
          <div>
            <h3 class="text-xl font-medium">
              <%= layout.name %>
              <% if layout.active? %>
                <%= render Badge.new(:blue, class: "ml-2") { "Active" } %>
              <% end %>
            </h3>
            <p class="text-muted text-sm">Created <%= layout.created_at.strftime("%b %d, %Y") %></p>
          </div>
          <div class="flex gap-2 items-center">
            <% unless layout.active? %>
              <%= button_to "Set Active", board_board_layout_path(@board, layout),
                  method: :patch,
                  params: { board_layout: { active: true } },
                  class: "btn btn-outline btn-sm" %>
            <% end %>
            <div class="dropdown" data-controller="dropdown">
              <button type="button" class="btn-icon" title="Layout actions" data-action="dropdown#toggle">
                <%= icon(:more_vertical) %>
              </button>
              <div class="dropdown-menu hidden" data-dropdown-target="menu">
                <%= button_to archive_board_board_layout_path(@board, layout),
                    method: :patch,
                    data: { turbo_confirm: "Archive #{layout.name}? Its #{pluralize(problems.size, 'problem')} are archived with it." },
                    class: "dropdown-item" do %>
                  <%= icon(:archive) %>
                  <span>Archive</span>
                <% end %>
                <%= button_to board_board_layout_path(@board, layout),
                    method: :delete,
                    data: { turbo_confirm: "Permanently delete #{layout.name} and its #{pluralize(problems.size, 'problem')}? This cannot be undone." },
                    class: "dropdown-item dropdown-item-danger" do %>
                  <%= icon(:trash) %>
                  <span>Delete</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <% if layout.image_layout.attached? %>
          <div class="mb-4">
            <%= image_tag image_board_board_layout_path(@board, layout), class: "layout-image", alt: "Layout image for #{layout.name}" %>
          </div>
        <% end %>

        <details class="disclosure mb-4">
          <summary class="disclosure-summary">
            <%= layout.image_layout.attached? ? "Replace layout image" : "Upload layout image" %>
          </summary>
          <div class="disclosure-body">
            <%= form_with model: [layout], url: board_board_layout_path(@board, layout), method: :patch, data: { turbo: false } do |form| %>
              <div class="upload-row">
                <%= form.file_field :image_layout, class: "form-input file-input-empty", accept: "image/*", data: { controller: "file-input", action: "change->file-input#change" } %>
                <%= form.submit "Upload Image", class: "btn btn-primary btn-sm" %>
              </div>
            <% end %>
          </div>
        </details>

        <%# The one place you can scan every problem by name on a phone: the
            problems index hides its list below 1024px. %>
        <% if problems.any? %>
          <details class="disclosure mb-4">
            <summary class="disclosure-summary">Browse <%= pluralize(problems.size, "problem") %></summary>
            <div class="disclosure-body">
              <ul class="problem-links">
                <% problems.each do |problem| %>
                  <li>
                    <%= link_to board_problem_path(@board, problem), class: "problem-link-row" do %>
                      <span><%= problem.name %></span>
                      <span class="text-sm text-muted"><%= problem.grade %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          </details>
        <% else %>
          <p class="text-muted italic mb-4">No problems on this layout yet</p>
        <% end %>

        <div class="flex items-center gap-4 flex-wrap">
          <%= link_to "Open in problems view",
                board_problems_path(@board, board_layout_id: layout.id), class: "btn-link" %>
          <%= link_to "Add Problem", new_board_problem_path(@board, board_layout_id: layout.id), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>

    <details class="card disclosure">
      <summary class="disclosure-summary">Add new layout</summary>
      <div class="disclosure-body">
        <%= form_with model: [BoardLayout.new], url: board_board_layouts_path(@board), data: { turbo: false } do |form| %>
          <div class="form-group">
            <%= form.text_field :name, value: default_layout_name, class: "form-input", required: true %>
          </div>
          <div class="form-group">
            <label class="form-label">Choose file:</label>
            <%= form.file_field :image_layout, class: "form-input file-input-empty", accept: "image/*", data: { controller: "file-input", action: "change->file-input#change" } %>
          </div>
          <div class="sample-option">
            <label class="checkbox-group">
              <%= form.check_box :use_sample_image %>
              <span class="checkbox-label">Homeboard not built yet? Select this to use a sample image</span>
            </label>
          </div>
          <%= form.submit "Add Layout", class: "btn btn-success" %>
        <% end %>
      </div>
    </details>
  </div>

  <%= link_to "Back to Boards", boards_path, class: "btn btn-outline" %>

  <div class="danger-zone">
    <h2 class="text-lg font-semibold mb-1">Danger zone</h2>
    <p class="text-sm text-muted mb-3">Deleting this board also removes its layouts and every problem on them.</p>
    <%= button_to "Delete Board", @board, method: :delete,
        data: { turbo_confirm: "Delete #{@board.name}? This also deletes all layouts and problems." },
        class: "btn btn-danger" %>
  </div>
<% end %>
