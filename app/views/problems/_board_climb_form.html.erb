<div class="board-climb-section" data-controller="offline-climb-form">
  <h3 class="text-lg font-semibold mb-3">Log a Board Climb</h3>
  <p class="text-xs text-muted mb-2" data-offline-climb-form-target="status"></p>
  <%= form_with model: [@current_board, problem, problem.board_climbs.build], url: board_problem_board_climbs_path(@current_board, problem), local: true, html: { data: { turbo: false, action: "submit->offline-climb-form#submit" } } do |f| %>
    <div class="form-group">
      <%= f.label :climbed_at, "Date & Time", class: "form-label" %>
      <%= f.datetime_local_field :climbed_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), step: 60, class: "form-input form-input-sm" %>
    </div>
    <% if problem.circuit? %>
      <div class="form-group">
        <%= f.label :number_of_moves, "Number of Moves", class: "form-label" %>
        <%= f.number_field :number_of_moves, min: 1, class: "form-input form-input-sm form-input-narrow", placeholder: "Moves completed" %>
      </div>
      <%= f.button "Log circuit", name: "board_climb[climb_type]", value: "circuit", class: "btn btn-primary climb-log-btn" %>
    <% else %>
      <div class="form-group">
        <%= f.label :attempts, class: "form-label" %>
        <%= f.number_field :attempts, min: 1, value: 1, inputmode: "numeric", class: "form-input form-input-sm form-input-narrow" %>
      </div>
      <%# Each button logs its own outcome, so one tap saves the climb. %>
      <div class="climb-log-actions">
        <%= f.button "Attempt", name: "board_climb[climb_type]", value: "attempt", class: "btn climb-log-btn climb-log-btn-attempt" %>
        <%= f.button "Send", name: "board_climb[climb_type]", value: "sent", class: "btn climb-log-btn climb-log-btn-sent" %>
        <%= f.button "Flash", name: "board_climb[climb_type]", value: "flash", class: "btn climb-log-btn climb-log-btn-flash" %>
      </div>
    <% end %>
  <% end %>
</div>
