// Homeboard offline service worker.
//
// Three caches:
//   - PIN_CACHE: pages + layout images explicitly pinned by the user.
//     Strategy: cache-first.
//   - ASSET_CACHE: stylesheets, JS, icons. Auto-populated as the user
//     browses online. Strategy: stale-while-revalidate.
//   - META_CACHE: bookkeeping only — records the last build we warmed for.
// Everything else is network-only.

// BUILD changes on every deploy (Kamal injects the git SHA as KAMAL_VERSION),
// which is the whole point of rendering this file through ERB: a new build
// means a byte-different script, so the browser installs it and we get an
// activate event to re-warm caches on. Without it a template-only deploy is
// invisible to anyone with a pinned board — they keep being served the HTML
// they cached before the deploy.
const BUILD = <%= raw Rails.application.config.x.build_version.to_json %>

// Digested URLs for this build, precached because a deploy rewrites every
// digest and the refreshed HTML points at assets nobody has fetched yet.
const CORE_ASSETS = <%= raw Offline::Assets.urls.to_json %>

// PIN_CACHE name is stable: it holds user-pinned data and must not be wiped
// just because we shipped unrelated SW changes. Deploy-time refreshing happens
// explicitly in applyBuild.
// ASSET_CACHE is versioned, but bumping it is not how deploys are picked up —
// entries are digest-keyed, so a deploy misses them naturally. It stays put
// across deploys so a user who goes offline mid-update keeps the old assets
// their old HTML references.
const PIN_CACHE = "homeboard-pin"
const ASSET_CACHE = "homeboard-assets-v1"
const META_CACHE = "homeboard-meta"
const OFFLINE_URL = "/offline"
const BUILD_KEY = "/__homeboard_build__"
const KNOWN_CACHES = [PIN_CACHE, ASSET_CACHE, META_CACHE]

async function refreshOfflineShell() {
  try {
    const res = await fetch(OFFLINE_URL, { credentials: "same-origin" })
    if (!res.ok) return
    const cache = await caches.open(PIN_CACHE)
    await cache.put(OFFLINE_URL, res.clone())
  } catch (_) { /* offline at SW update time */ }
}

// ---- deploy-time cache warming ----

async function warmedBuild() {
  const cache = await caches.open(META_CACHE)
  const res = await cache.match(BUILD_KEY)
  return res ? await res.text() : null
}

function isHtml(res) {
  return !!res && (res.headers.get("content-type") || "").includes("text/html")
}

// Bring every offline-critical cache entry up to the current build: this
// build's assets, then each pinned HTML document (whose markup *and* importmap
// both changed with the deploy). Layout images in PIN_CACHE are skipped —
// they're content-addressed and a deploy doesn't touch them.
//
// Bails without recording the build if anything fails, so a partial warm is
// retried rather than silently leaving a pinned board that renders unstyled.
async function warmForBuild() {
  if (await warmedBuild() === BUILD) return

  const assetCache = await caches.open(ASSET_CACHE)
  for (const url of CORE_ASSETS) {
    if (!await recache(assetCache, url)) return
  }

  const pinCache = await caches.open(PIN_CACHE)
  for (const request of await pinCache.keys()) {
    if (!isHtml(await pinCache.match(request))) continue
    if (!await recache(pinCache, request.url)) return
  }

  await (await caches.open(META_CACHE)).put(BUILD_KEY, new Response(BUILD))
}

async function recache(cache, url) {
  try {
    const res = await fetch(url, { credentials: "same-origin" })
    if (!res.ok) return false
    await cache.put(cacheKey(url), res.clone())
    return true
  } catch (_) {
    return false
  }
}

// Deploys land while the tab is open, and an installed PWA can go days without
// a real navigation to trigger an update check, so the page nudges us too.
// Collapse concurrent callers onto one run — warming is idempotent but not
// cheap, and turbo:load fires often.
let warming = null
function applyBuild() {
  warming ||= warmForBuild().finally(() => { warming = null })
  return warming
}

self.addEventListener("install", (event) => {
  event.waitUntil((async () => {
    await refreshOfflineShell()
    self.skipWaiting()
  })())
})

self.addEventListener("activate", (event) => {
  event.waitUntil((async () => {
    try {
      const names = await caches.keys()
      await Promise.all(names.filter(n => !KNOWN_CACHES.includes(n)).map(n => caches.delete(n)))
      // Re-fetch the offline shell on every SW update so changes to the
      // /offline route or its auth posture take effect without forcing
      // every user to re-pin their boards. Unconditional, unlike applyBuild
      // below, which is gated on the build stamp having moved.
      await refreshOfflineShell()
      await applyBuild()
    } catch (_) { /* cache storage unavailable — still claim clients */ }
    await self.clients.claim()
  })())
})

function cacheKey(url) {
  const u = new URL(url, self.location.origin)
  u.search = ""
  u.hash = ""
  return u.toString().replace(/\/$/, "")
}

function isAssetRequest(request) {
  const u = new URL(request.url)
  if (u.origin !== self.location.origin) return false
  if (u.pathname.startsWith("/assets/")) return true
  if (u.pathname.startsWith("/rails/active_storage/")) return true
  if (/^\/icon\.(png|svg)$/.test(u.pathname)) return true
  if (u.pathname === "/manifest.json") return true
  return false
}

// Cache storage can break independently of the network (corruption,
// eviction under storage pressure). If it does, every branch here must
// degrade to a plain network fetch — never take the app down with it.
self.addEventListener("fetch", (event) => {
  const request = event.request
  if (request.method !== "GET") return

  event.respondWith((async () => {
    try {
      const cached = await respondFromCache(event, request)
      if (cached) return cached
    } catch (_) { /* cache storage unavailable — fall through to network */ }

    try {
      return await fetch(request)
    } catch (_) {
      if (request.mode === "navigate") {
        try {
          const cache = await caches.open(PIN_CACHE)
          const fallback = await cache.match(OFFLINE_URL)
          if (fallback) return fallback
        } catch (_) { /* cache storage unavailable */ }
      }
      return Response.error()
    }
  })())
})

async function respondFromCache(event, request) {
  const keyed = cacheKey(request.url)
  const pinCache = await caches.open(PIN_CACHE)
  const pinned = await pinCache.match(keyed)

  // Pinned HTML is an offline fallback, not an online accelerator. Served
  // cache-first it answers a filtered URL with the unfiltered page (the
  // cache key strips the query), Turbo then adopts that stripped URL after
  // form submissions, and every server-rendered value on the page (filter
  // links, sent flags, counts) is as old as the last revalidation. Online,
  // let the server answer; keep the cached copy fresh for when we lose it.
  if (pinned && isHtml(pinned)) {
    try {
      const fresh = await fetch(request)
      const url = new URL(request.url)
      if (fresh.ok && !fresh.redirected && !url.search) {
        event.waitUntil(pinCache.put(keyed, fresh.clone()).catch(() => { /* quota */ }))
      }
      return fresh
    } catch (_) {
      return pinned
    }
  }

  if (pinned) {
    event.waitUntil((async () => {
      try {
        const fresh = await fetch(keyed, { credentials: "same-origin" })
        if (fresh.ok) await pinCache.put(keyed, fresh.clone())
      } catch (_) { /* offline */ }
    })())
    return pinned
  }

  if (isAssetRequest(request)) {
    const assetCache = await caches.open(ASSET_CACHE)
    const cached = await assetCache.match(keyed)
    if (cached) {
      event.waitUntil(fetch(request).then(res => {
        if (res.ok) return assetCache.put(keyed, res.clone())
      }).catch(() => { /* offline */ }))
      return cached
    }
    const res = await fetch(request)
    if (res.ok) event.waitUntil(assetCache.put(keyed, res.clone()).catch(() => { /* quota */ }))
    return res
  }

  return null
}

self.addEventListener("message", (event) => {
  const { type, payload } = event.data || {}
  if (type === "PIN") {
    event.waitUntil(pinUrls(payload.urls, event.source))
  } else if (type === "UNPIN") {
    event.waitUntil(unpinUrls(payload.urls))
  } else if (type === "REFRESH") {
    event.waitUntil(refreshUrls(payload.add, payload.update, payload.remove, event.source))
  } else if (type === "SYNC") {
    event.waitUntil(applyBuild())
  }
})

async function pinUrls(urls, source) {
  const cache = await caches.open(PIN_CACHE)
  let done = 0
  for (const url of urls) {
    try {
      const res = await fetch(url, { credentials: "same-origin" })
      if (res.ok) await cache.put(cacheKey(url), res.clone())
    } catch (e) { /* skip */ }
    done++
    if (source) source.postMessage({ type: "PIN_PROGRESS", done, total: urls.length })
  }
  if (source) source.postMessage({ type: "PIN_DONE", total: urls.length })
}

async function unpinUrls(urls) {
  const cache = await caches.open(PIN_CACHE)
  await Promise.all(urls.map(u => cache.delete(cacheKey(u))))
}

async function refreshUrls(add = [], update = [], remove = [], source) {
  const cache = await caches.open(PIN_CACHE)
  await Promise.all(remove.map(u => cache.delete(cacheKey(u))))
  for (const url of [...add, ...update]) {
    try {
      const res = await fetch(url, { credentials: "same-origin" })
      if (res.ok) await cache.put(cacheKey(url), res.clone())
    } catch (e) { /* skip */ }
  }
  if (source) source.postMessage({ type: "REFRESH_DONE" })
}
