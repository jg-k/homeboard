<%= render PageLayout.new(title: "Tracking") do %>

  <%= render TabBar.new(label: "Tracking", tabs: [
        TabBar::Tab.new(label: "Exercises", url: tracking_path(tab: "exercises"), active: @tab == "exercises"),
        TabBar::Tab.new(label: "Metrics", url: tracking_path(tab: "metrics"), active: @tab == "metrics")
      ]) %>

  <% if @tab == "exercises" %>
    <%= render "tracking/exercises" %>
  <% else %>
    <%= render "tracking/metrics" %>
  <% end %>
<% end %>
